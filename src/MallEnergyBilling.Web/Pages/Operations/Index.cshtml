@page
@model MallEnergyBilling.Web.Pages.Operations.IndexModel
@{ViewData["Title"]="Operations & configuration";}
<section class="hero compact"><div><span class="eyebrow">ADMINISTRATION</span><h1>Operations & configuration</h1><p>Controllers, shops, meters, tariffs, readings, audit and resilience.</p></div><div class="btn-row"><a class="button" asp-page-handler="Csv">Export readings CSV</a>@if(User.IsInRole("Administrator")){<form method="post" asp-page-handler="Backup"><button>Create backup</button></form>}</div></section>
<div class="tabs"><a href="#controllers">Controllers</a><a href="#shops">Shops</a><a href="#meters">Meters</a><a href="#tariffs">Tariffs</a><a href="#readings">Readings</a>@if(User.IsInRole("Administrator")){<a href="#backup">Backup & restore</a>}</div>
<section id="controllers" class="panel"><h2>Controller management</h2><table><thead><tr><th>Name</th><th>Panel / type</th><th>Serial</th><th>Slave</th><th>Polling</th><th>Condition</th></tr></thead><tbody>@foreach(var x in Model.Controllers){<tr><td><b>@x.Name</b></td><td>@x.MdbPanel · @x.CommunicationType</td><td>@x.ComPort · @x.BaudRate @x.Parity @x.DataBits/@x.StopBits</td><td>@x.SlaveAddress</td><td>@x.PollingIntervalSeconds s / @x.TimeoutMilliseconds ms / @x.RetryCount retries</td><td><span class="status">@x.Condition</span></td></tr>}</tbody></table><p class="note">Physical Modbus RTU Function 03 communication is enabled. COM1, slave 1, D100/D101 was hardware-verified during commissioning.</p></section>
<section id="shops" class="panel"><h2>Shop register</h2><table><thead><tr><th>Number</th><th>Name / tenant</th><th>Location</th><th>Contact</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model.Shops){<tr><td>@x.ShopNumber</td><td><b>@x.Name</b><small>@x.TenantName</small></td><td>@x.Floor · @x.Zone · @x.MdbPanel</td><td>@x.ContactPerson @x.Telephone</td><td><span class="status">@x.Status</span></td></tr>}</tbody></table></section>
<section id="meters" class="panel"><h2>Meter register</h2><table><thead><tr><th>Meter</th><th>Shop</th><th>Register</th><th>Conversion</th><th>CT / pulse</th><th>Reading</th></tr></thead><tbody>@foreach(var x in Model.Meters){<tr><td><b>@x.Name</b><small>@x.SerialNumber</small></td><td>@x.Shop?.Name</td><td>@x.StartingRegister · @x.DataType · @x.WordOrder</td><td>× @x.ScalingFactor</td><td>@x.CtPrimary/@x.CtSecondary · @x.PulseConstant imp/kWh</td><td>@x.LastReading.ToString("N3") kWh</td></tr>}</tbody></table></section>
<section id="tariffs" class="panel"><h2>Meter-specific tariff history</h2><form method="post" asp-page-handler="Tariff" class="inline-form"><select name="meterId" required><option value="">Select meter</option>@foreach(var meter in Model.Meters){<option value="@meter.Id">@meter.Name - @meter.Shop?.Name</option>}</select><input type="number" min="0.000001" step="0.000001" name="price" placeholder="New price" required/><select name="currency" aria-label="Currency">@foreach(var code in Model.Currencies){<option value="@code">@code</option>}</select><input type="datetime-local" name="effective" required/><input name="reason" placeholder="Reason (optional)"/><button>Confirm meter tariff</button></form><p class="note">Select the ISO currency for each meter. UGX is available for Uganda, and each meter retains its own currency and tariff history.</p><table><thead><tr><th>Meter</th><th>Price</th><th>Effective</th><th>Changed</th><th>User / reason</th></tr></thead><tbody>@foreach(var x in Model.Tariffs){<tr><td><b>@(x.Meter?.Name??"Legacy unassigned")</b><small>@x.Meter?.SerialNumber</small></td><td><b>@x.Currency @x.PricePerKwh.ToString("0.000000")</b></td><td>@x.EffectiveFrom.ToLocalTime().ToString("g")</td><td>@x.CreatedAt.ToLocalTime().ToString("g")</td><td>@x.ChangedBy<small>@x.Reason</small></td></tr>}</tbody></table></section>
<section id="readings" class="panel"><h2>Reading history</h2><table><thead><tr><th>Timestamp</th><th>Meter</th><th>Raw</th><th>Accumulated</th><th>Source</th><th>Quality</th></tr></thead><tbody>@foreach(var x in Model.Readings){<tr><td>@x.Timestamp.ToLocalTime().ToString("g")</td><td>@x.Meter?.Name</td><td>@x.RawValue</td><td>@x.AccumulatedKwh.ToString("N3") kWh</td><td>@x.Source</td><td>@x.Quality</td></tr>}</tbody></table></section>
@if(User.IsInRole("Administrator")){<section id="backup" class="panel"><div class="panel-title"><div><h2>Backup and restore</h2><p class="note">Backup folder: <code>@Model.BackupPath</code></p></div><form method="post" asp-page-handler="Backup"><button>Create new backup</button></form></div>@if(TempData["BackupSuccess"] is string backupSuccess){<div class="alert-success">@backupSuccess</div>}@if(TempData["BackupError"] is string backupError){<div class="alert-error">@backupError</div>}<div class="table-responsive"><table><thead><tr><th>Backup file</th><th>Created</th><th>Size</th><th></th></tr></thead><tbody>@if(Model.BackupFiles.Count==0){<tr><td colspan="4">No backups created yet.</td></tr>}@foreach(var file in Model.BackupFiles){<tr><td><b>@file.Name</b></td><td>@file.Modified.ToString("dd MMM yyyy HH:mm:ss")</td><td>@((file.Size/1024.0/1024.0).ToString("N2")) MB</td><td><form method="post" asp-page-handler="Restore" onsubmit="return confirm('Are you sure you want to restore this backup? Current data will be replaced.');"><input type="hidden" name="fileName" value="@file.Name"/><button class="danger-btn">Restore</button></form></td></tr>}</tbody></table></div></section>}
