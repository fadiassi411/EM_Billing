@page
@model MallEnergyBilling.Web.Pages.Operations.IndexModel
@{ViewData["Title"]="Operations & configuration";}
<section class="hero compact"><div><span class="eyebrow">ADMINISTRATION</span><h1>Operations & configuration</h1><p>Controllers, shops, meters, tariffs, readings, audit and resilience.</p></div><div class="btn-row"><a class="button" asp-page-handler="Csv">Export readings CSV</a>@if(User.IsInRole("Administrator")){<form method="post" asp-page-handler="Backup"><button>Create backup</button></form>}</div></section>
<div class="tabs"><a href="#controllers">Controllers</a><a href="#shops">Shops</a><a href="#meters">Meters</a><a href="#tariffs">Tariffs</a><a href="#billing">Monthly billing</a><a href="#readings">Readings</a>@if(User.IsInRole("Administrator")){<a href="#backup">Backup & restore</a>}</div>
<section id="controllers" class="panel"><h2>Controller management</h2><table><thead><tr><th>Name</th><th>Panel / type</th><th>Serial</th><th>Slave</th><th>Polling</th><th>Condition</th></tr></thead><tbody>@foreach(var x in Model.Controllers){<tr><td><b>@x.Name</b></td><td>@x.MdbPanel · @x.CommunicationType</td><td>@x.ComPort · @x.BaudRate @x.Parity @x.DataBits/@x.StopBits</td><td>@x.SlaveAddress</td><td>@x.PollingIntervalSeconds s / @x.TimeoutMilliseconds ms / @x.RetryCount retries</td><td><span class="status">@x.Condition</span></td></tr>}</tbody></table><p class="note">Physical Modbus RTU Function 03 communication is enabled. COM1, slave 1, D100/D101 was hardware-verified during commissioning.</p></section>
<section id="shops" class="panel"><h2>Shop register</h2><table><thead><tr><th>Number</th><th>Name / tenant</th><th>Location</th><th>Contact</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model.Shops){<tr><td>@x.ShopNumber</td><td><b>@x.Name</b><small>@x.TenantName</small></td><td>@x.Floor · @x.Zone · @x.MdbPanel</td><td>@x.ContactPerson @x.Telephone</td><td><span class="status">@x.Status</span></td></tr>}</tbody></table></section>
<section id="meters" class="panel"><h2>Meter register</h2><table><thead><tr><th>Meter</th><th>Power source</th><th>Shop</th><th>Register</th><th>Conversion</th><th>CT / pulse</th><th>Reading</th></tr></thead><tbody>@foreach(var x in Model.Meters){<tr><td><b>@x.Name</b><small>@x.SerialNumber</small></td><td><span class="status">@x.PowerSource</span></td><td>@x.Shop?.Name</td><td>@x.StartingRegister · @x.DataType · @x.WordOrder</td><td>× @x.ScalingFactor</td><td>@x.CtPrimary/@x.CtSecondary · @x.PulseConstant imp/kWh</td><td>@x.LastReading.ToString("N3") kWh</td></tr>}</tbody></table></section>
<section id="tariffs" class="panel"><h2>Meter tariff</h2><form method="post" asp-page-handler="Tariff" class="inline-form"><select name="meterId" required><option value="">Select meter</option>@foreach(var meter in Model.Meters){<option value="@meter.Id">@meter.Name - @meter.Shop?.Name</option>}</select><input type="number" min="0.000001" step="0.000001" name="price" placeholder="Tariff price" required/><select name="currency" aria-label="Currency">@foreach(var code in Model.Currencies){<option value="@code">@code</option>}</select><input name="reason" placeholder="Reason (optional)"/><button>Save tariff from now</button></form><p class="note">The tariff becomes active immediately. Each meter keeps its own tariff and currency.</p><table><thead><tr><th>Meter</th><th>Price</th><th>Active from</th><th>Changed</th><th>User / reason</th></tr></thead><tbody>@foreach(var x in Model.Tariffs){<tr><td><b>@(x.Meter?.Name??"Legacy unassigned")</b><small>@x.Meter?.SerialNumber</small></td><td><b>@x.Currency @x.PricePerKwh.ToString("0.000000")</b></td><td>@x.EffectiveFrom.ToLocalTime().ToString("g")</td><td>@x.CreatedAt.ToLocalTime().ToString("g")</td><td>@x.ChangedBy<small>@x.Reason</small></td></tr>}</tbody></table></section>
<section id="billing" class="panel">
 <div class="panel-title"><div><h2>Monthly billing & invoices</h2><p class="note">Choose the consumption period and the exact dates that will appear on the invoice.</p></div></div>
 @if(TempData["BillingSuccess"] is string billingSuccess){<div class="alert-success">@billingSuccess</div>}
 @if(TempData["BillingError"] is string billingError){<div class="alert-error">@billingError</div>}
 @if(User.IsInRole("Administrator")||User.IsInRole("BillingManager")){
 <form method="post" asp-page-handler="ScheduleInvoices" class="admin-form billing-form">
  <h3>Automatic invoice generation</h3>
  <div class="form-grid"><label>Generate invoices on<input type="datetime-local" name="generateAt" required/></label><label>Payment due after (days)<input type="number" name="dueDays" min="0" max="365" value="10" required/></label></div>
  <p class="note">At this date and time, the system automatically creates draft invoices for every active meter for the previous completed calendar month. Keep Watch Dog EM running.</p>
  <button>Schedule invoice generation</button>
 </form>
 @if(Model.InvoiceSchedules.Count>0){<div class="table-responsive"><table><thead><tr><th>Generation date/time</th><th>Period</th><th>Status</th><th>Result</th></tr></thead><tbody>@foreach(var schedule in Model.InvoiceSchedules){var run=schedule.GenerateAt.ToLocalTime();var end=new DateOnly(run.Year,run.Month,1).AddDays(-1);<tr><td>@run.ToString("dd MMM yyyy h:mm tt")</td><td>@end.ToString("MMMM yyyy")</td><td><span class="status">@(schedule.Completed?"Completed":"Scheduled")</span></td><td>@schedule.Result</td></tr>}</tbody></table></div>}
 <details><summary>Manual billing options</summary>
 <form method="post" asp-page-handler="GenerateInvoices" class="admin-form billing-form">
  <div class="form-grid">
   <label>Consumption period start<input type="date" name="periodStart" value="@Model.SuggestedPeriodStart.ToString("yyyy-MM-dd")" required/></label>
   <label>Consumption period end<input type="date" name="periodEnd" value="@Model.SuggestedPeriodEnd.ToString("yyyy-MM-dd")" required/></label>
   <label>Invoice date<input type="date" name="invoiceDate" value="@Model.SuggestedInvoiceDate.ToString("yyyy-MM-dd")" required/></label>
   <label>Payment due date<input type="date" name="dueDate" value="@Model.SuggestedDueDate.ToString("yyyy-MM-dd")" required/></label>
   <label>Fixed charge per invoice<input type="number" name="fixedCharge" min="0" step="0.01" value="0"/></label>
   <label>Other charge per invoice<input type="number" name="otherCharge" min="0" step="0.01" value="0"/></label>
   <label>Tax %<input type="number" name="taxPercent" min="0" max="100" step="0.01" value="0"/></label>
   <label>Discount per invoice<input type="number" name="discount" min="0" step="0.01" value="0"/></label>
  </div>
  <p class="note"><b>Generate</b> creates draft invoices for every active meter. Review the invoice dates, readings and amounts below, then use <b>Finalize & publish</b>.</p>
  <button>Generate draft invoices</button>
 </form>
 </details>
 }else{<p class="note">Invoice generation is available to Administrators and Billing Managers.</p>}
 <h3>Billing periods</h3>
 <div class="table-responsive"><table><thead><tr><th>Period</th><th>Consumption dates</th><th>Invoice date</th><th>Due date</th><th>Status</th><th>Invoices</th><th></th></tr></thead><tbody>
 @if(Model.BillingPeriods.Count==0){<tr><td colspan="7">No billing period has been created yet.</td></tr>}
 @foreach(var period in Model.BillingPeriods){var periodInvoices=Model.Invoices.Where(x=>x.BillingPeriodId==period.Id).ToList();var firstInvoice=periodInvoices.FirstOrDefault();<tr><td><b>@period.Number</b></td><td>@period.StartDate.ToString("dd MMM yyyy") – @period.EndDate.ToString("dd MMM yyyy")</td><td>@(firstInvoice?.InvoiceDate.ToLocalTime().ToString("dd MMM yyyy")??"—")</td><td>@(firstInvoice?.DueDate.ToLocalTime().ToString("dd MMM yyyy")??"—")</td><td><span class="status">@period.Status</span></td><td>@periodInvoices.Count</td><td>@if((User.IsInRole("Administrator")||User.IsInRole("BillingManager"))&&period.Status!=MallEnergyBilling.Web.Models.BillingStatus.Finalized&&period.Status!=MallEnergyBilling.Web.Models.BillingStatus.Closed){<form method="post" asp-page-handler="FinalizeInvoices" onsubmit="return confirm('Finalize and publish all invoices in this period? They will be locked.');"><input type="hidden" name="periodId" value="@period.Id"/><button>Finalize & publish</button></form>}</td></tr>}
 </tbody></table></div>
 <h3>Invoices</h3>
 <div class="table-responsive"><table><thead><tr><th>Invoice</th><th>Shop / meter</th><th>Invoice date</th><th>Due date</th><th>Status</th><th>Total</th><th>Balance</th><th></th></tr></thead><tbody>
 @if(Model.Invoices.Count==0){<tr><td colspan="8">No invoices created yet.</td></tr>}
 @foreach(var invoice in Model.Invoices){<tr><td><b>@invoice.InvoiceNumber</b></td><td>@invoice.Meter?.Shop?.Name<small>@invoice.Meter?.Name</small></td><td>@invoice.InvoiceDate.ToLocalTime().ToString("dd MMM yyyy")</td><td>@invoice.DueDate.ToLocalTime().ToString("dd MMM yyyy")</td><td><span class="status">@invoice.Status</span></td><td>@invoice.Currency @invoice.Total.ToString("N2")</td><td>@invoice.Currency @invoice.Balance.ToString("N2")</td><td><a class="button" asp-page="/Invoices/Details" asp-route-id="@invoice.Id">View / PDF</a>@if((User.IsInRole("Administrator")||User.IsInRole("BillingManager"))&&invoice.Status!=MallEnergyBilling.Web.Models.InvoiceStatus.Draft&&invoice.Status!=MallEnergyBilling.Web.Models.InvoiceStatus.Cancelled&&invoice.Balance>0){<details class="payment-entry"><summary>Record payment</summary><form method="post" asp-page-handler="RecordPayment"><input type="hidden" name="invoiceId" value="@invoice.Id"/><label>Amount (@invoice.Currency)<input type="number" name="amount" min="0.01" max="@invoice.Balance" step="0.01" required/></label><label>Payment date<input type="date" name="paymentDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" required/></label><label>Method<select name="method"><option>Cash</option><option>Bank transfer</option><option>Mobile money</option><option>Card</option><option>Cheque</option></select></label><label>Reference<input name="referenceNumber"/></label><label>Notes<input name="notes"/></label><button>Save payment</button></form></details>}</td></tr>}
 </tbody></table></div>
</section>
<section id="readings" class="panel"><h2>Reading history</h2><table><thead><tr><th>Timestamp</th><th>Meter</th><th>Raw</th><th>Accumulated</th><th>Source</th><th>Quality</th></tr></thead><tbody>@foreach(var x in Model.Readings){<tr><td>@x.Timestamp.ToLocalTime().ToString("g")</td><td>@x.Meter?.Name</td><td>@x.RawValue</td><td>@x.AccumulatedKwh.ToString("N3") kWh</td><td>@x.Source</td><td>@x.Quality</td></tr>}</tbody></table></section>
@if(User.IsInRole("Administrator")){<section id="backup" class="panel"><div class="panel-title"><div><h2>Backup and restore</h2><p class="note">Backup folder: <code>@Model.BackupPath</code></p></div><form method="post" asp-page-handler="Backup"><button>Create new backup</button></form></div>@if(TempData["BackupSuccess"] is string backupSuccess){<div class="alert-success">@backupSuccess</div>}@if(TempData["BackupError"] is string backupError){<div class="alert-error">@backupError</div>}<div class="table-responsive"><table><thead><tr><th>Backup file</th><th>Created</th><th>Size</th><th></th></tr></thead><tbody>@if(Model.BackupFiles.Count==0){<tr><td colspan="4">No backups created yet.</td></tr>}@foreach(var file in Model.BackupFiles){<tr><td><b>@file.Name</b></td><td>@file.Modified.ToString("dd MMM yyyy HH:mm:ss")</td><td>@((file.Size/1024.0/1024.0).ToString("N2")) MB</td><td><form method="post" asp-page-handler="Restore" onsubmit="return confirm('Are you sure you want to restore this backup? Current data will be replaced.');"><input type="hidden" name="fileName" value="@file.Name"/><button class="danger-btn">Restore</button></form></td></tr>}</tbody></table></div></section>}
