@page "{id:int}"
@model MallEnergyBilling.Web.Pages.Invoices.DetailsModel
@{ViewData["Title"]=$"Invoice {Model.Invoice.InvoiceNumber}";var i=Model.Invoice;}
<section class="hero compact"><div><span class="eyebrow">ENERGY INVOICE</span><h1>@i.InvoiceNumber</h1><p>@i.Shop?.Name · @i.Status</p></div><div class="btn-row"><a class="button" asp-page-handler="Download" asp-route-id="@i.Id">Download PDF</a><button onclick="window.print()">Print preview</button></div></section>
<section class="panel invoice-preview"><div class="panel-title"><h2>Mall Energy Metering & Billing</h2><span>Due @i.DueDate.ToString("dd MMM yyyy")</span></div><div class="grid"><div><b>Billed to</b><p>@i.Shop?.Name<br/>Shop @i.Shop?.ShopNumber<br/>Tenant: @i.Shop?.TenantName</p></div><div><b>Meter</b><p>@i.Meter?.Name<br/>@i.Meter?.SerialNumber<br/>@i.Meter?.Controller?.MdbPanel</p></div></div><table><thead><tr><th>Previous reading</th><th>Current reading</th><th>Consumption</th><th>Tariff</th></tr></thead><tbody><tr><td>@i.OpeningReading.ToString("N2") kWh</td><td>@i.ClosingReading.ToString("N2") kWh</td><td>@i.ConsumptionKwh.ToString("N2") kWh</td><td>@i.Currency @i.TariffPerKwh.ToString("N4") / kWh</td></tr></tbody></table><table><tbody><tr><td>Energy charge</td><td>@i.Currency @i.EnergyCharge.ToString("N2")</td></tr><tr><td>Fixed and additional charges</td><td>@i.Currency @((i.FixedCharges+i.OtherCharges).ToString("N2"))</td></tr><tr><td>Tax</td><td>@i.Currency @i.Tax.ToString("N2")</td></tr><tr><td>Discount</td><td>- @i.Currency @i.Discount.ToString("N2")</td></tr><tr><td>Previous balance</td><td>@i.Currency @i.PreviousBalance.ToString("N2")</td></tr></tbody></table><div class="tariff"><small>TOTAL AMOUNT DUE</small><strong>@i.Currency @i.Total.ToString("N2")</strong></div></section>
