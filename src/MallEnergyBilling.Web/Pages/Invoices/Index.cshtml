@page
@model MallEnergyBilling.Web.Pages.Invoices.IndexModel
@{ViewData["Title"]="Published invoices";}
<section class="hero compact"><div><span class="eyebrow">BILLING ARCHIVE</span><h1>Published invoices</h1><p>Every finalized monthly invoice is saved here for viewing and PDF download.</p></div></section>
<section class="meter-search-banner"><div class="search-banner-copy"><span class="search-power-icon">⌕</span><div><h2>Find an invoice</h2><p>Search by day, month, year, invoice number, shop, tenant or meter.</p></div></div><form method="get" class="meter-search-form"><label class="sr-only" for="invoiceSearch">Search invoices</label><input id="invoiceSearch" name="q" value="@Model.Search" placeholder="Example: 01, September 2026, SHOP-01 or tenant name"/><button>Search</button>@if(Model.Search.Length>0){<a class="button search-clear" asp-page="/Invoices/Index">Clear</a>}</form></section>
<section class="panel"><div class="panel-title"><h2>Invoice archive</h2><span>@Model.Invoices.Count result(s)</span></div>@if(Model.Invoices.Count==0){<div class="meter-empty-state"><span>⌕</span><strong>No matching invoice was found.</strong><p>Try another day, month, year, shop or invoice number.</p></div>}else{<div class="table-responsive"><table><thead><tr><th>Invoice</th><th>Shop / meter</th><th>Published</th><th>Due date</th><th>Status</th><th>Total</th><th>Balance</th><th></th></tr></thead><tbody>@foreach(var invoice in Model.Invoices){<tr><td><b>@invoice.InvoiceNumber</b></td><td>@invoice.Shop?.Name<small>@invoice.Shop?.TenantName · @invoice.Meter?.Name</small></td><td>@invoice.InvoiceDate.ToLocalTime().ToString("dd MMM yyyy")</td><td>@invoice.DueDate.ToLocalTime().ToString("dd MMM yyyy")</td><td><span class="status">@invoice.Status</span></td><td>@invoice.Currency @invoice.Total.ToString("N2")</td><td>@invoice.Currency @invoice.Balance.ToString("N2")</td><td><a class="button" asp-page="/Invoices/Details" asp-route-id="@invoice.Id">View / PDF</a></td></tr>}</tbody></table></div>}</section>
