@page
@model MallEnergyBilling.Web.Pages.Invoices.IndexModel
@{ViewData["Title"]="Published invoices";var months=System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.MonthNames;}
<section class="hero compact"><div><span class="eyebrow">BILLING ARCHIVE</span><h1>Published invoices</h1><p>Every published invoice is kept here and saved as a PDF on the server. Pick a customer, a year and a month, then download one invoice or all of them at once.</p></div></section>
@if(TempData["InvoiceError"] is string error){<div class="alert-error">@error</div>}
<section class="panel invoice-finder">
 <h2>Find invoices</h2>
 <form method="get" class="admin-form">
  <div class="form-grid">
   <label>Customer (shop)<select name="shop"><option value="">All customers</option>@foreach(var s in Model.Shops){<option value="@s.Id" selected="@(Model.ShopId==s.Id)">@s.ShopNumber — @s.Name@(string.IsNullOrWhiteSpace(s.TenantName)||s.TenantName==s.Name?"":$" ({s.TenantName})")</option>}</select></label>
   <label>Year<select name="year"><option value="">All years</option>@foreach(var y in Model.Years){<option value="@y" selected="@(Model.Year==y)">@y</option>}</select></label>
   <label>Month (billed)<select name="month"><option value="">Whole year</option>@for(var m=1;m<=12;m++){<option value="@m" selected="@(Model.Month==m)">@m.ToString("00") — @months[m-1]</option>}</select></label>
   <label>Search (optional)<input name="q" value="@Model.Search" placeholder="Invoice number, meter, tenant…"/></label>
  </div>
  <div class="btn-row"><button>Show invoices</button><button class="secondary" name="handler" value="Zip" @(Model.Invoices.Count==0?"disabled":"")>Download @Model.Invoices.Count PDF(s) as ZIP</button>@if(Model.Filtered){<a class="button secondary" asp-page="/Invoices/Index">Clear filters</a>}</div>
 </form>
 <p class="note">The month is the month that was billed: the November bill (published on 1 December) is under 11. On the server every invoice is also saved as a PDF in <code>@Model.ArchiveFolder\year\year-month</code>.</p>
</section>
<section class="panel"><div class="panel-title"><h2>Invoice archive</h2><span>@Model.Invoices.Count result(s)</span></div>@if(Model.Invoices.Count==0){<div class="meter-empty-state"><span>⌕</span><strong>No matching invoice was found.</strong><p>Try another customer, year or month.</p></div>}else{<div class="table-responsive"><table data-grid="invoices" data-grid-placeholder="Filter these invoices…"><thead><tr><th>Invoice</th><th>Customer / meter</th><th>Billed month</th><th>Published</th><th>Due date</th><th>Status</th><th>Total</th><th>Balance</th><th></th></tr></thead><tbody>@foreach(var invoice in Model.Invoices){var billed=MallEnergyBilling.Web.Services.InvoiceArchiveService.BilledMonth(invoice);<tr><td><b>@invoice.InvoiceNumber</b></td><td>@invoice.Shop?.ShopNumber — @invoice.Shop?.Name<small>@invoice.Shop?.TenantName · @invoice.Meter?.Name · @(invoice.Meter?.UtilityType==MallEnergyBilling.Web.Models.UtilityType.Water?"Water":invoice.Meter?.PowerSource.ToString())</small></td><td>@billed.ToString("MM-yyyy")<small>@billed.ToString("MMMM yyyy")</small></td><td>@invoice.InvoiceDate.ToLocalTime().ToString("dd MMM yyyy")</td><td>@invoice.DueDate.ToLocalTime().ToString("dd MMM yyyy")</td><td><span class="status">@invoice.Status</span></td><td>@invoice.Currency @invoice.Total.ToString("N2")</td><td>@invoice.Currency @invoice.Balance.ToString("N2")</td><td><div class="row-actions keep-labels"><a class="act" asp-page-handler="Pdf" asp-route-id="@invoice.Id" title="Download PDF" aria-label="Download PDF of @invoice.InvoiceNumber"><svg viewBox='0 0 24 24' aria-hidden='true'><path d='M12 4v11M7 10l5 5 5-5M5 20h14'/></svg><span>PDF</span></a><a class="act" asp-page="/Invoices/Details" asp-route-id="@invoice.Id" title="View invoice" aria-label="View @invoice.InvoiceNumber"><svg viewBox='0 0 24 24' aria-hidden='true'><path d='M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z'/><circle cx='12' cy='12' r='3'/></svg><span>View</span></a></div></td></tr>}</tbody></table></div>}</section>
