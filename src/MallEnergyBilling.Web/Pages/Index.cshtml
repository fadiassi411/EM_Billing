@page
@model MallEnergyBilling.Web.Pages.IndexModel
@{ViewData["Title"]="Watch Dog EM Dashboard";var failures=Model.Meters.Count(x=>x.CommunicationStatus is "Failed" or "Frozen");var connected=Model.Meters.Count(x=>x.CommunicationStatus=="Connected");}
<section class="hero"><div><span class="eyebrow">MALL ENERGY CONTROL</span><h1>Energy and billing dashboard</h1><p>Operational overview of metering, consumption, invoicing and collections.</p></div><div class="tariff"><small>METER-SPECIFIC ELECTRICITY TARIFFS</small><strong>@Model.TariffSummary</strong><span>@Model.CurrentTariffs.Count meter tariff(s) active · latest change @Model.LatestTariffChange?.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span></div></section>
<div class="cards"><div class="metric"><span>Total shops</span><b>@Model.Shops</b></div><div class="metric"><span>Active meters</span><b>@Model.Meters.Count(x=>x.Active)</b></div><div class="metric"><span>Meters online</span><b>@connected</b></div><div class="metric danger"><span>Meter alarms</span><b>@failures</b></div><div class="metric"><span>Outstanding balance by currency</span><b>@Model.OutstandingSummary</b></div></div>
<section class="panel"><div class="panel-title"><h2>Live meter status</h2><span>Automatically updated by the background service</span></div><div class="table-responsive"><table><thead><tr><th>Meter / shop</th><th>Power source</th><th>MDB panel</th><th>Accumulated reading / cost</th><th>Communication</th><th>Last reading</th><th></th></tr></thead><tbody>@foreach(var m in Model.Meters){<tr><td><b>@m.Name</b><small>@m.Shop?.Name · @m.SerialNumber</small></td><td><span class="source-badge source-@m.PowerSource.ToString().ToLowerInvariant()">@m.PowerSource</span></td><td>@m.Controller?.MdbPanel</td><td><b>@m.LastReading.ToString("N3") kWh</b>@if(Model.CurrentTariffByMeter.TryGetValue(m.Id,out var tariff)){<small>Accumulated cost: @tariff.Currency @((m.LastReading*tariff.PricePerKwh).ToString("N2")) · @tariff.Currency @tariff.PricePerKwh.ToString("N4")/kWh</small>}else{<small>Cost unavailable — tariff not set</small>}</td><td><span class="status @m.CommunicationStatus.ToLower()">@m.CommunicationStatus</span></td><td>@(m.LastReadingAt?.ToLocalTime().ToString("g")??"No recent reading")</td><td><a class="button meter-view-button" asp-page="/Meters/Details" asp-route-id="@m.Id">View meter</a></td></tr>}</tbody></table></div></section>
<section class="panel"><div class="panel-title"><h2>Invoice register</h2>@if(User.Identity?.IsAuthenticated==true){<a asp-page="/Operations/Index">Billing operations →</a>}</div><table><thead><tr><th>Invoice</th><th>Shop</th><th>Status</th><th>Invoice date</th><th>Due date</th><th>Total</th><th>Balance</th><th></th></tr></thead><tbody>@foreach(var i in Model.Invoices){<tr><td><b>@i.InvoiceNumber</b></td><td>@i.Shop?.Name<small>@i.Shop?.TenantName</small></td><td><span class="status">@i.Status</span></td><td>@i.InvoiceDate.ToString("dd MMM yyyy")</td><td>@i.DueDate.ToString("dd MMM yyyy")</td><td>@i.Currency @i.Total.ToString("N2")</td><td>@i.Currency @i.Balance.ToString("N2")</td><td>@if(User.Identity?.IsAuthenticated==true){<a class="button" asp-page="/Invoices/Details" asp-route-id="@i.Id">View / PDF</a>}</td></tr>}</tbody></table></section>
<section class="panel"><div class="panel-title"><h2>System condition</h2><span>Final production dashboard</span></div><div class="cards"><div class="metric"><span>Controllers configured</span><b>@Model.Meters.Select(x=>x.ControllerId).Distinct().Count()</b></div><div class="metric"><span>Connected meters</span><b>@connected</b></div><div class="metric"><span>Communication alarms</span><b>@failures</b></div><div class="metric"><span>Invoices issued</span><b>@Model.Invoices.Count</b></div><div class="metric"><span>Collection rate by currency</span><b>@Model.CollectionRateSummary</b></div></div></section>
@section Scripts{
<script>
(() => {
  const key = "mall-dashboard-scroll";
  const saved = sessionStorage.getItem(key);
  if (saved !== null) { window.scrollTo(0, Number(saved)); sessionStorage.removeItem(key); }
  window.setTimeout(() => {
    sessionStorage.setItem(key, String(window.scrollY));
    window.location.reload();
  }, 5000);
})();
</script>
}
