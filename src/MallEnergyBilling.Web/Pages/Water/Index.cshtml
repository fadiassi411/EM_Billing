@page
@model MallEnergyBilling.Web.Pages.Water.IndexModel
@{ViewData["Title"]="Water metering";}
<section class="hero water-hero"><div><span class="eyebrow">WATER METERING &amp; BILLING</span><h1>Water</h1><p>Live accumulated-volume readings from M-Bus meters through Modbus gateways.</p></div><div class="water-drop" aria-hidden="true">💧</div></section>
<section class="water-search-banner"><form method="get"><div><label for="q">Find a water meter</label><p>Search by meter number, name, customer, tenant, shop, room or location.</p></div><div class="water-search-controls"><input id="q" name="q" value="@Model.Search" placeholder="Search water meters…"/><button>Search</button>@if(Model.Search.Length>0){<a class="button" asp-page="Index">Clear</a>}</div></form></section>
<section class="panel water-meter-panel"><div class="panel-title"><h2>Water meters</h2><span>@Model.Meters.Count result(s) · automatically refreshed</span></div>
@if(Model.Meters.Count==0){<div class="meter-empty-state"><span aria-hidden="true">💧</span><strong>No matching meter was found.</strong><p>Add a Water meter or try another search.</p></div>}else{<div class="table-responsive"><table><thead><tr><th>Meter / shop</th><th>Gateway</th><th>Register</th><th>Accumulated volume</th><th>Communication</th><th>Last reading</th><th></th></tr></thead><tbody>@foreach(var meter in Model.Meters){<tr><td><b>@meter.Name</b><small>@meter.Shop?.Name · @meter.Shop?.TenantName · @meter.SerialNumber</small></td><td>@meter.Controller?.Name<small>@(meter.Controller?.CommunicationType=="ModbusTcp"?$"{meter.Controller.IpAddress}:{meter.Controller.TcpPort}":meter.Controller?.ComPort)</small></td><td>@meter.StartingRegister<small>@meter.DataType · @meter.WordOrder · × @meter.ScalingFactor</small></td><td><span class="water-reading-value">@meter.LastReading.ToString("N3") m³</span></td><td><span class="status @meter.CommunicationStatus.ToLowerInvariant().Replace(" ","-")">@meter.CommunicationStatus</span></td><td>@(meter.LastReadingAt?.ToLocalTime().ToString("g")??"No recent reading")</td><td><a class="button water-button" asp-page="/Meters/Details" asp-route-id="@meter.Id">View meter</a></td></tr>}</tbody></table></div>}
</section>
@section Scripts{<script>(()=>{const key="water-page-scroll";const saved=sessionStorage.getItem(key);if(saved!==null){window.scrollTo(0,Number(saved));sessionStorage.removeItem(key)}window.setTimeout(()=>{sessionStorage.setItem(key,String(window.scrollY));window.location.reload()},5000)})();</script>}
