<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewData["Title"] · Mall Energy</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/admin.css" asp-append-version="true"/></head><body><header><a asp-page="/Index" class="brand"><span>⚡</span><div>MALL ENERGY<small>Metering & Billing</small></div></a><nav><a asp-page="/Index">Dashboard</a>@if(User.Identity?.IsAuthenticated==true){<a asp-page="/Operations/Index">Operations</a>}@if(User.IsInRole("Administrator")){<a asp-page="/Admin/Shops/Index">Shops</a><a asp-page="/Admin/Controllers/Index">Controller setup</a><a asp-page="/Admin/Audit/Index">Audit trail</a>}<partial name="_LoginPartial"/></nav></header><main>@RenderBody()</main><footer><span>Mall Energy Control · Local installation</span><small class="watermark">MicroBrain by Fadi Assi</small><span>System time @DateTime.Now.ToString("dd MMM yyyy HH:mm")</span></footer><script src="~/lib/jquery/dist/jquery.min.js"></script>@await RenderSectionAsync("Scripts",false)</body></html>
