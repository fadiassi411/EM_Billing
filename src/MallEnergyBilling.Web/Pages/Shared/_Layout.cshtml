@inject MallEnergyBilling.Web.Services.SystemFeatureService Features
@using System.Reflection
@{var waterBillingEnabled=await Features.WaterBillingEnabledAsync();var appVersion=typeof(MallEnergyBilling.Web.Pages.IndexModel).Assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion?.Split('+')[0]??"2.2.1";}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@ViewData["Title"] · Watch Dog EM</title>
    <link rel="icon" type="image/png" href="~/images/watch-dog-logo-visible.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/watch-dog.css" asp-append-version="true" />
    <script>
        try {
            if (sessionStorage.getItem("watchDogSplashSeen")) {
                document.documentElement.classList.add("splash-seen");
            }
        } catch { }
    </script>
</head>
<body>
    <div id="startupSplash" class="startup-splash" role="status" aria-label="Watch Dog EM is starting">
        <div class="startup-brand">
            <img src="~/images/watch-dog-logo-visible.png" alt="Watch Dog EM logo" />
            <h1>Watch Dog Energy Management</h1>
            <p>Watch Every Watt.</p>
            <small>By MicroBrain</small>
        </div>
    </div>
    <header>
        <a asp-page="/Index" class="brand">
            <img src="~/images/watch-dog-logo-visible.png" alt="Watch Dog EM logo" />
            <div>WATCH DOG ENERGY MANAGEMENT<small>Watch Every Watt</small></div>
        </a>
        <nav>
            <details class="nav-menu"><summary>Main</summary><div><a asp-page="/Index">Dashboard</a>@if(User.Identity?.IsAuthenticated==true){<a asp-page="/PowerSources/Grid">⚡ Grid</a><a asp-page="/PowerSources/Generator">⌁ Generator</a>@if(waterBillingEnabled){<a class="water-nav-link" asp-page="/Water/Index">💧 Water</a>}<a asp-page="/Operations/Index">Operations</a><a asp-page="/Invoices/Index">Published invoices</a>}<button type="button" class="nav-about-button" data-open-about>ⓘ About Watch Dog</button></div></details>
            <details class="nav-menu"><summary>Settings</summary><div>@if(User.IsInRole("Administrator")){<a asp-page="/Admin/Shops/Index">Shops</a><a asp-page="/Admin/Controllers/Index">Controller setup</a><a asp-page="/Admin/Features/Index">System features</a><a asp-page="/Admin/Users/Index">Users &amp; Access</a><a asp-page="/Admin/Email/Index">Invoice email</a><a asp-page="/Admin/Audit/Index">Audit trail</a><a asp-page="/Operations/Index" asp-fragment="backup">Backup &amp; restore</a>}else{<a asp-page="/Admin/Login">Administrator login</a>}</div></details>
            <partial name="_LoginPartial" />
        </nav>
    </header>
    <dialog id="aboutWatchDog" class="about-dialog" aria-labelledby="aboutWatchDogTitle">
        <div class="about-dialog-header">
            <img src="~/images/watch-dog-logo-visible.png" alt="Watch Dog Energy Management logo" />
            <div><span class="eyebrow">MICROBRAIN SOFTWARE</span><h2 id="aboutWatchDogTitle">Watch Dog Energy Management</h2><p>Watch Every Watt</p></div>
            <button type="button" class="about-dialog-close" data-close-about aria-label="Close About window">×</button>
        </div>
        <div class="about-dialog-body">
            <div class="about-version"><span>Software version</span><strong>@appVersion</strong></div>
            <p>Watch Dog Energy Management is a local Windows energy-metering and customer billing platform for commercial buildings and malls.</p>
            <dl>
                <div><dt>Monitoring</dt><dd>Grid, Generator and optional Water meters</dd></div>
                <div><dt>Communication</dt><dd>Modbus RTU and Modbus TCP/IP, including M-Bus meters through a Modbus gateway</dd></div>
                <div><dt>Billing</dt><dd>Meter-specific tariffs, monthly invoices, PDF output and optional SMTP delivery</dd></div>
                <div><dt>Access</dt><dd>Main Watch Dog PC and browser monitoring across the same local network</dd></div>
            </dl>
            <p class="about-credit"><strong>Developed and published by MicroBrain</strong><br />Fadi Assi · © @DateTime.Now.Year</p>
        </div>
        <div class="about-dialog-footer"><button type="button" data-close-about>Close</button></div>
    </dialog>
    <main>@RenderBody()</main>
    <footer>
        <span>Watch Dog EM · Watch Every Watt</span>
        <small class="watermark">MicroBrain by Fadi Assi</small>
        <span>System time @DateTime.Now.ToString("dd MMM yyyy HH:mm")</span>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", false)
</body>
</html>
