<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@ViewData["Title"] · Black Dog</title>
    <link rel="icon" type="image/png" href="~/images/black-dog-logo-visible.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/black-dog.css" asp-append-version="true" />
    <script>
        try {
            if (sessionStorage.getItem("blackDogSplashSeen")) {
                document.documentElement.classList.add("splash-seen");
            }
        } catch { }
    </script>
</head>
<body>
    <div id="startupSplash" class="startup-splash" role="status" aria-label="Black Dog is starting">
        <div class="startup-brand">
            <img src="~/images/black-dog-logo-visible.png" alt="Black Dog logo" />
            <h1>BlackDog Energy</h1>
            <p>Watch Every Watt.</p>
            <small>By MicroBrain</small>
        </div>
    </div>
    <header>
        <a asp-page="/Index" class="brand">
            <img src="~/images/black-dog-logo-visible.png" alt="Black Dog logo" />
            <div>BLACK DOG<small>Watch Every Watt</small></div>
        </a>
        <nav>
            <a asp-page="/Index">Dashboard</a>
            @if (User.Identity?.IsAuthenticated == true) { <a asp-page="/Operations/Index">Operations</a> }
            @if (User.IsInRole("Administrator")) { <a asp-page="/Admin/Shops/Index">Shops</a><a asp-page="/Admin/Controllers/Index">Controller setup</a><a asp-page="/Admin/Audit/Index">Audit trail</a> }
            <partial name="_LoginPartial" />
        </nav>
    </header>
    <main>@RenderBody()</main>
    <footer>
        <span>Black Dog · Watch Every Watt</span>
        <small class="watermark">MicroBrain by Fadi Assi</small>
        <span>System time @DateTime.Now.ToString("dd MMM yyyy HH:mm")</span>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", false)
</body>
</html>
