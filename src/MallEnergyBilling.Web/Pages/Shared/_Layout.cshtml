<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@ViewData["Title"] · Watch Dog EM</title>
    <link rel="icon" type="image/png" href="~/images/watch-dog-logo-visible.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/watch-dog.css" asp-append-version="true" />
    <script>
        try {
            if (sessionStorage.getItem("watchDogSplashSeen")) {
                document.documentElement.classList.add("splash-seen");
            }
        } catch { }
    </script>
</head>
<body>
    <div id="startupSplash" class="startup-splash" role="status" aria-label="Watch Dog EM is starting">
        <div class="startup-brand">
            <img src="~/images/watch-dog-logo-visible.png" alt="Watch Dog EM logo" />
            <h1>Watch Dog EM</h1>
            <p>Watch Every Watt.</p>
            <small>By MicroBrain</small>
        </div>
    </div>
    <header>
        <a asp-page="/Index" class="brand">
            <img src="~/images/watch-dog-logo-visible.png" alt="Watch Dog EM logo" />
            <div>WATCH DOG EM<small>Watch Every Watt</small></div>
        </a>
        <nav>
            <a asp-page="/Index">Dashboard</a>
            @if (User.Identity?.IsAuthenticated == true) {
                <a class="power-nav-link" asp-page="/PowerSources/UMEME"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/></svg>UMEME</a>
                <a class="power-nav-link" asp-page="/PowerSources/Generator"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v6m0 6v6M5.6 5.6l4.2 4.2m4.4 4.4 4.2 4.2M3 12h6m6 0h6M5.6 18.4l4.2-4.2m4.4-4.4 4.2-4.2"/></svg>Generator</a>
                <a asp-page="/Operations/Index">Operations</a>
            }
            @if (User.IsInRole("Administrator")) { <a asp-page="/Admin/Shops/Index">Shops</a><a asp-page="/Admin/Controllers/Index">Controller setup</a><a asp-page="/Admin/Users/Index">Users &amp; Access</a><a asp-page="/Admin/Audit/Index">Audit trail</a> }
            else { <a asp-page="/Admin/Login">Administrator login</a> }
            <partial name="_LoginPartial" />
        </nav>
    </header>
    <main>@RenderBody()</main>
    <footer>
        <span>Watch Dog EM · Watch Every Watt</span>
        <small class="watermark">MicroBrain by Fadi Assi</small>
        <span>System time @DateTime.Now.ToString("dd MMM yyyy HH:mm")</span>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", false)
</body>
</html>
