@model MallEnergyBilling.Web.Pages.PowerSources.PowerSourceMetersPageModel
@{
    var online = Model.Meters.Count(x => x.DisplayStatus is "Connected" or "Online");
    var alarms = Model.Meters.Count(x => x.DisplayStatus is "Failed" or "Frozen" or "Stale" or "Timeout" or "BACnet Error" or "Configuration Error" or "Counter Review" or "Partial Data");
    var total = Model.Meters.Sum(x => x.LastReading);
}
<section class="hero compact source-hero">
    <div>
        <span class="eyebrow">Power source</span>
        <h1>@Model.Title meters</h1>
        <p>@Model.Description <span class="live-dot" data-live-indicator>Live</span></p>
    </div>
    <span class="source-badge source-@Model.Source.ToString().ToLowerInvariant()">@Model.Meters.Count meter@(Model.Meters.Count == 1 ? "" : "s")</span>
</section>

<div class="cards" id="source-kpis" data-live>
    <div class="metric m-info"><span>Meters</span><b>@Model.Meters.Count</b><small>@Model.Meters.Count(x => x.Active) active</small></div>
    <div class="metric m-ok"><span>Online</span><b>@online</b><small>reading normally</small></div>
    <div class="metric @(alarms > 0 ? "m-bad" : "m-ok")"><span>Alarms</span><b>@alarms</b><small>@(alarms > 0 ? "need attention" : "all clear")</small></div>
    <div class="metric"><span>Total accumulated</span><b>@total.ToString("N0") kWh</b><small>sum of meter totals</small></div>
</div>

<section class="panel source-meter-panel">
    <div class="panel-title"><h2>@Model.Title meter register</h2><span>Type to search instantly · click a column to sort · press / to search</span></div>
    @if(!string.IsNullOrWhiteSpace(Model.Search)){<div class="filter-note"><span>Showing only meters matching “@Model.Search”.</span><a asp-page="@Model.PagePath">Show all meters</a></div>}
    <div class="table-responsive">
        <table data-grid="source-meters" data-grid-placeholder="Search meter, serial, customer, shop, floor, zone…" data-grid-empty="No meter matches this search.">
            <thead><tr><th>Meter</th><th>Customer / tenant</th><th>Shop / location</th><th>Controller</th><th>Reading</th><th>Status</th><th data-sort="off"></th></tr></thead>
            <tbody id="source-meter-rows" data-live>
            @if(Model.Meters.Count == 0){<tr><td colspan="7">No @Model.Title.ToLowerInvariant() meter found.</td></tr>}
            @foreach(var meter in Model.Meters){
                <tr>
                    <td><b>@meter.Name</b><small>ID @meter.Id · @meter.SerialNumber</small></td>
                    <td>@(string.IsNullOrWhiteSpace(meter.Shop?.TenantName) ? "—" : meter.Shop.TenantName)<small>@meter.Shop?.ContactPerson</small></td>
                    <td><b>@meter.Shop?.ShopNumber · @meter.Shop?.Name</b><small>@meter.Shop?.Floor · @meter.Shop?.Zone</small></td>
                    <td>@meter.Controller?.Name<small>@meter.Controller?.MdbPanel</small></td>
                    <td data-sort="@meter.LastReading.ToString(System.Globalization.CultureInfo.InvariantCulture)"><span class="meter-reading-value">@meter.LastReading.ToString("N3") kWh</span><small>@(meter.LastReadingAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "No reading yet")</small></td>
                    <td><span class="status">@meter.DisplayStatus</span></td>
                    <td><a class="button" asp-page="/Meters/Details" asp-route-id="@meter.Id">Open</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
<div data-live-refresh="10" hidden></div>
