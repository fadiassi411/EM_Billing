@page
@model MallEnergyBilling.Web.Pages.Admin.Shops.IndexModel
@{ ViewData["Title"] = "Shop setup"; }
<section class="hero compact"><div><span class="eyebrow">ADMINISTRATOR ONLY</span><h1>Shop setup</h1><p>Create a shop before assigning meter channels.</p></div><a class="button" asp-page="/Admin/Controllers/Index">Controller setup</a></section>
@if(TempData["Message"] is string message){<div class="alert-success">@message</div>}@if(TempData["Error"] is string error){<div class="alert-error">@error</div>}
<section class="panel admin-form">
 <h2>Add shop</h2>
 <form method="post">
  <div asp-validation-summary="All" class="validation"></div>
  <div class="form-grid">
   <label>Shop number<input asp-for="Input.ShopNumber" placeholder="SHOP-01"/></label>
   <label>Shop name<input asp-for="Input.Name"/></label>
   <label>Tenant name<input asp-for="Input.TenantName"/></label>
   <label>Floor<input asp-for="Input.Floor"/></label>
   <label>Zone<input asp-for="Input.Zone"/></label>
   <label>MDB panel<input asp-for="Input.MdbPanel"/></label>
   <label>Contact person<input asp-for="Input.ContactPerson"/></label>
   <label>Telephone<input asp-for="Input.Telephone"/></label>
   <label>Email<input asp-for="Input.Email"/></label>
   <label>Status<select asp-for="Input.Status" asp-items="Html.GetEnumSelectList<MallEnergyBilling.Web.Models.ShopStatus>()"></select></label>
   <label>Billing address<input asp-for="Input.BillingAddress"/></label>
   <label>Tax number<input asp-for="Input.TaxNumber"/></label>
  </div>
  <label>Notes (optional)<textarea asp-for="Input.Notes" rows="2"></textarea></label>
  <label>Reason (optional)<textarea asp-for="Input.Reason" rows="2"></textarea></label>
  <button type="submit">Add shop</button>
 </form>
</section>
<section class="panel"><h2>Configured shops</h2><p class="note">A shop can be deleted only when it has no meters and no invoices. To stop billing a shop that has history, set its status to Inactive or Vacant.</p><div class="table-responsive"><table data-grid="shops" data-grid-placeholder="Search shop number, name, tenant, location…"><thead><tr><th>Number</th><th>Name / tenant</th><th>Location</th><th>MDB panel</th><th>Meters</th><th>Status</th><th></th></tr></thead><tbody>@if(Model.Shops.Count==0){<tr><td colspan="7">No shops configured.</td></tr>}@foreach(var shop in Model.Shops){var blocked=Model.DeleteBlockedReason(shop.Id);<tr><td><b>@shop.ShopNumber</b></td><td>@shop.Name<small>@shop.TenantName</small></td><td>@shop.Floor · @shop.Zone</td><td>@shop.MdbPanel</td><td>@Model.MeterCounts.GetValueOrDefault(shop.Id)</td><td><span class="status">@shop.Status</span></td><td><div class="row-actions keep-labels"><a class="act" asp-page="Edit" asp-route-id="@shop.Id" title="Edit shop" aria-label="Edit shop @shop.ShopNumber"><svg viewBox='0 0 24 24' aria-hidden='true'><path d='M4 20h4L19 9l-4-4L4 16v4Z'/><path d='m13.5 6.5 4 4'/></svg><span>Edit</span></a><form method="post" asp-page-handler="Delete" data-blocked="@blocked" data-shop="@shop.ShopNumber" onsubmit="if(this.dataset.blocked){alert(this.dataset.blocked);return false;}return confirm('Delete shop '+this.dataset.shop+'? This cannot be undone.');"><input type="hidden" name="shopId" value="@shop.Id"/><button class="act act-danger" title="@(blocked ?? "Delete this shop")" aria-label="Delete shop @shop.ShopNumber"><svg viewBox='0 0 24 24' aria-hidden='true'><path d='M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3'/></svg><span>Delete</span></button></form></div></td></tr>}</tbody></table></div></section>
