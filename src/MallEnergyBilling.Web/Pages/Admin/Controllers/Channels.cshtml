@page "{id:int}"
@model MallEnergyBilling.Web.Pages.Admin.Controllers.ChannelsModel
@{ViewData["Title"]=$"{Model.Controller.Name} meter channels";}
<section class="hero compact"><div><span class="eyebrow">ADMINISTRATOR ONLY</span><h1>@Model.Controller.Name — meter channels</h1><p>@Model.Meters.Count of 36 configured. Generate sequential registers, then adjust any channel individually.</p></div><a class="button" asp-page="Edit" asp-route-id="@Model.Controller.Id">Controller communication</a></section>
@if(TempData["Error"] is string error){<div class="alert-error">@error</div>}@if(TempData["Success"] is string success){<div class="alert-success">@success</div>}
<section class="panel admin-form"><h2>Bulk-create meter register channels</h2><p class="note">Use register 4196 for D100. Confirm the register stride for meters 2-36 from the Delta PLC program before saving.</p><form method="post" asp-page-handler="Generate"><div asp-validation-summary="All" class="validation"></div><div class="form-grid"><label>Meter name prefix<input asp-for="MeterNamePrefix" placeholder="Meter"/></label><label>First meter serial number<input asp-for="FirstMeterSerial" placeholder="Enter the physical serial when available"/></label><label>Controller<input value="@Model.Controller.Name" readonly/></label><label>Number of channels<input asp-for="ChannelCount" max="36"/></label><label>First register address<input asp-for="FirstRegister"/></label><label>Register stride<input asp-for="RegisterStride"/></label><label>Data type<select asp-for="DataType" asp-items="Html.GetEnumSelectList<MallEnergyBilling.Web.Models.RegisterDataType>()"></select></label><label>Word order<select asp-for="WordOrder" asp-items="Html.GetEnumSelectList<MallEnergyBilling.Web.Models.WordOrder>()"></select></label><label>Scaling factor<input asp-for="ScalingFactor"/></label><label>Initial shop assignment<select asp-for="ShopId">@foreach(var s in Model.Shops){<option value="@s.Id">@s.ShopNumber — @s.Name</option>}</select></label></div><label>Reason (optional)<textarea asp-for="Reason" rows="2"></textarea></label><button>Generate channels</button></form></section>
<section class="panel"><h2>Register matrix</h2><table><thead><tr><th>Channel</th><th>Register</th><th>Type</th><th>Word order</th><th>Scale</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var m in Model.Meters){<tr><td><b>@m.Name</b><small>@m.SerialNumber</small></td><td>@m.StartingRegister</td><td>@m.DataType</td><td>@m.WordOrder</td><td>@m.ScalingFactor</td><td>@(m.Active?"Active":"Not commissioned")</td><td><div class="btn-row"><a class="button" asp-page="Meter" asp-route-id="@m.Id">Edit</a><form method="post" asp-page-handler="Delete" asp-route-id="@Model.Controller.Id" onsubmit="return confirm('Are you sure you want to delete Channel');"><input type="hidden" name="meterId" value="@m.Id"/><button class="danger-btn">Delete</button></form></div></td></tr>}</tbody></table></section>
