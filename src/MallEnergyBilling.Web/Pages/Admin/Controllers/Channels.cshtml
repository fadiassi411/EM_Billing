@page "{id:int}"
@model MallEnergyBilling.Web.Pages.Admin.Controllers.ChannelsModel
@{ViewData["Title"]=$"{Model.Controller.Name} meter channels";}
<section class="hero compact"><div><span class="eyebrow">ADMINISTRATOR ONLY</span><h1>@Model.Controller.Name — meter channels</h1><p>@Model.Meters.Count of 45 configured. Create meter entries, then commission each meter.</p></div><a class="button" asp-page="Edit" asp-route-id="@Model.Controller.Id">Controller communication</a></section>
@if(TempData["Error"] is string error){<div class="alert-error">@error</div>}@if(TempData["Success"] is string success){<div class="alert-success">@success</div>}
<section class="panel admin-form"><h2>Bulk-create meter channels</h2><p class="note">Configure sequential Modbus registers or BACnet objects according to the selected controller communication type.</p><form method="post" asp-page-handler="Generate"><div asp-validation-summary="All" class="validation"></div><div class="form-grid"><label>Meter name prefix<input asp-for="MeterNamePrefix" placeholder="Meter"/></label><label>First meter serial number<input asp-for="FirstMeterSerial" placeholder="Enter the physical serial when available"/></label><label>Controller / gateway<input value="@Model.Controller.Name" readonly/></label><label>Utility type<select asp-for="UtilityType" asp-items="Html.GetEnumSelectList<MallEnergyBilling.Web.Models.UtilityType>()"></select><small>Water readings are stored and billed in m³.</small></label><label>Electricity source<select asp-for="PowerSource" asp-items="Html.GetEnumSelectList<MallEnergyBilling.Web.Models.PowerSource>()"></select><small>Used only by electricity meters.</small></label><label>Number of channels<input asp-for="ChannelCount" max="45"/></label>@if(Model.Controller.CommunicationType=="BacnetIp"){<p>After creating a meter, open BACnet Points to browse or manually enter its objects and measurements.</p>}else{<label>First register address<input asp-for="FirstRegister"/></label><label>Register stride<input asp-for="RegisterStride"/></label><label>Data type<select asp-for="DataType" asp-items="Html.GetEnumSelectList<MallEnergyBilling.Web.Models.RegisterDataType>()"></select></label><label>Word order<select asp-for="WordOrder" asp-items="Html.GetEnumSelectList<MallEnergyBilling.Web.Models.WordOrder>()"></select></label>}@if(Model.Controller.CommunicationType!="BacnetIp"){<label>Scaling factor<input asp-for="ScalingFactor"/></label>}else{<input type="hidden" asp-for="ScalingFactor"/>}<label>Initial shop assignment<select asp-for="ShopId">@foreach(var s in Model.Shops){<option value="@s.Id">@s.ShopNumber — @s.Name</option>}</select></label></div><label>Reason (optional)<textarea asp-for="Reason" rows="2"></textarea></label><button>Generate channels</button></form></section>
<section class="panel"><h2>Channel matrix</h2><p class="note">Administrator controls: Archive preserves history and hides the meter from live pages. Permanently delete removes the meter and all related readings, tariffs, invoices, and payments.</p><div class="table-responsive"><table data-grid="channels" data-grid-size="50" data-grid-placeholder="Search channel, serial, register, shop…"><thead><tr><th>Channel</th><th>Utility / source</th><th>Register / BACnet object</th><th>Format</th><th>Scale</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var m in Model.Meters){var archived=m.CommunicationStatus=="Archived";<tr><td><b>@m.Name</b><small>@m.SerialNumber</small></td><td><span class="status">@m.UtilityType</span><small>@(m.UtilityType==MallEnergyBilling.Web.Models.UtilityType.Water?"Meter/gateway":m.PowerSource.ToString())</small></td><td>@(Model.Controller.CommunicationType=="BacnetIp"?"See BACnet Points":m.StartingRegister.ToString())</td><td>@(Model.Controller.CommunicationType=="BacnetIp"?"Point mappings":$"{m.DataType} · {m.WordOrder}")</td><td>@(Model.Controller.CommunicationType=="BacnetIp"?"Per point":m.ScalingFactor.ToString())</td><td><span class="status">@(archived?"Archived":m.Active?"Active":"Not commissioned")</span></td><td><div class="row-actions"><a class="act" asp-page="Meter" asp-route-id="@m.Id" title="Edit meter settings" aria-label="Edit meter settings"><svg viewBox='0 0 24 24' aria-hidden='true'><path d='M4 20h4L19 9l-4-4L4 16v4Z'/><path d='m13.5 6.5 4 4'/></svg><span>Edit</span></a>@if(Model.Controller.CommunicationType=="BacnetIp"){<a class="act" asp-page="Points" asp-route-id="@m.Id" title="BACnet points" aria-label="BACnet points"><svg viewBox='0 0 24 24' aria-hidden='true'><path d='M4 7h10M18 7h2M4 17h4M12 17h8'/><circle cx='16' cy='7' r='2'/><circle cx='10' cy='17' r='2'/></svg><span>Points</span></a>}@if(archived){<form method="post" asp-page-handler="RestoreMeter" asp-route-id="@Model.Controller.Id"><input type="hidden" name="meterId" value="@m.Id"/><button class="act" title="Bring the meter back to live pages" aria-label="Bring the meter back to live pages"><svg viewBox='0 0 24 24' aria-hidden='true'><path d='M3 12a9 9 0 1 0 3-6.7L3 8'/><path d='M3 3v5h5'/></svg><span>Restore</span></button></form>}else{<form method="post" asp-page-handler="Archive" asp-route-id="@Model.Controller.Id" onsubmit="return confirm('Archive this meter? Its history will be preserved.');"><input type="hidden" name="meterId" value="@m.Id"/><button class="act" title="Hide from live pages, keep history" aria-label="Hide from live pages, keep history"><svg viewBox='0 0 24 24' aria-hidden='true'><rect x='3' y='4' width='18' height='5' rx='1.5'/><path d='M5 9v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9M10 13h4'/></svg><span>Archive</span></button></form>}<form method="post" asp-page-handler="PermanentDelete" asp-route-id="@Model.Controller.Id" onsubmit="var value=prompt('PERMANENT DELETE: this removes all readings, tariffs, invoices and payments for this meter. Type DELETE to continue.');if(value!=='DELETE')return false;this.querySelector('[name=confirmation]').value=value;"><input type="hidden" name="meterId" value="@m.Id"/><input type="hidden" name="confirmation"/><button class="act act-danger" title="Permanently delete the meter and all its records" aria-label="Permanently delete the meter and all its records"><svg viewBox='0 0 24 24' aria-hidden='true'><path d='M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3'/></svg><span>Delete</span></button></form></div></td></tr>}</tbody></table></div></section>
