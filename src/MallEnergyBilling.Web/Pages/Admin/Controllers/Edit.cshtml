@page "{id:int?}"
@model MallEnergyBilling.Web.Pages.Admin.Controllers.EditModel
@{ViewData["Title"]=Model.Input.Id==0?"Add controller":"Edit controller";}
<section class="hero compact"><div><span class="eyebrow">ADMINISTRATOR ONLY</span><h1>@ViewData["Title"]</h1><p>Configure, confirm and test communication before enabling collection.</p></div><a class="button" asp-page="Index">Back to controllers</a></section>
@if(Model.TestResult is not null){<div class="sim-banner">@Model.TestResult</div>}
<form method="post" class="panel admin-form"><div asp-validation-summary="All" class="validation"></div><input type="hidden" asp-for="Input.Id"/>
<h2>1. Controller identity</h2><div class="form-grid"><label>Name<input asp-for="Input.Name"/></label><label>MDB panel<input asp-for="Input.MdbPanel"/></label><label>Communication type<select asp-for="Input.CommunicationType" id="communication-type"><option value="ModbusRtu">Modbus RTU (RS-485)</option><option value="ModbusTcp">Modbus TCP/IP (Ethernet)</option><option value="BacnetIp">BACnet/IP (UDP)</option></select></label><label class="check"><input asp-for="Input.Enabled"/> Enabled</label></div>
<h2>2–3. Communication address</h2><div class="form-grid"><div class="form-grid transport-settings" id="rtu-settings"><label>Windows USB/RS-485 port<input asp-for="Input.ComPort"/></label><label>Baud rate<select asp-for="Input.BaudRate"><option>9600</option><option>19200</option><option>38400</option><option>57600</option><option>115200</option></select></label><label>Parity<select asp-for="Input.Parity"><option>None</option><option>Even</option><option>Odd</option></select></label><label>Data bits<input asp-for="Input.DataBits"/></label><label>Stop bits<input asp-for="Input.StopBits"/></label></div><div class="form-grid transport-settings" id="ip-settings"><label>Device IP address or host name<input asp-for="Input.IpAddress" placeholder="192.168.1.50"/></label></div><div class="form-grid transport-settings" id="tcp-settings"><label>Modbus TCP port<input asp-for="Input.TcpPort"/></label></div><div class="form-grid transport-settings" id="bacnet-settings"><label>BACnet UDP port<input asp-for="Input.BacnetUdpPort"/><small>Default BACnet/IP port is 47808.</small></label><label>Local BACnet network interface<select asp-for="Input.BacnetLocalIp"><option value="">Select the network connected to your meter</option>@foreach(var nic in Model.Interfaces){<option value="@nic.Address">@nic.Name — @nic.Address @(nic.Special ? "(special adapter — select explicitly)" : "") @(!nic.IsUp ? "(disconnected)" : "")</option>}</select><small>Interfaces on the Watchdog server. No adapter is selected automatically.</small></label><label>BACnet device instance<input asp-for="Input.BacnetDeviceInstance"/></label></div><label id="modbus-unit">Slave / unit address<input asp-for="Input.SlaveAddress"/></label></div>
<h2>4. Polling resilience</h2><div class="form-grid"><label>Polling interval (seconds)<input asp-for="Input.PollingIntervalSeconds"/></label><label>Response timeout (ms)<input asp-for="Input.TimeoutMilliseconds"/></label><label>Retry count<input asp-for="Input.RetryCount"/></label></div>
<div id="assigned-registers"><h2>5. Assigned meter registers</h2>@if(Model.Input.Id==0){<p class="note">Save the controller first, then assign and configure meters.</p>}else if(Model.Meters.Count==0){<p class="note">No meters are assigned to this controller.</p>}else{<table><thead><tr><th>Meter</th><th>Register</th><th>Type / word order</th><th>Scale</th><th></th></tr></thead><tbody>@foreach(var m in Model.Meters){<tr><td>@m.Name<small>@m.SerialNumber</small></td><td>@m.StartingRegister</td><td>@m.DataType · @m.WordOrder</td><td>@m.ScalingFactor</td><td><a class="button" asp-page="Meter" asp-route-id="@m.Id">Edit register</a></td></tr>}</tbody></table>}
</div><div id="bacnet-actions"><h2>5. BACnet connection and discovery</h2><div class="btn-row"><button type="button" data-bacnet="discover">Discover BACnet Devices</button><button type="button" data-bacnet="test">Test BACnet Connection</button></div><p id="bacnet-result" role="status"></p><div id="bacnet-devices"></div>@if(Model.Input.Id>0){<a class="button" asp-page="Channels" asp-route-id="@Model.Input.Id">6. Configure meters and BACnet points</a>}<p>Save the device, add a meter, then browse or manually configure its points.</p></div><h2>7. Commissioning confirmation</h2><p class="note">BACnet connection testing reads the Device Object. Use BACnet Points to test measurement values. Modbus testing reads the first assigned register.</p><label class="check"><input asp-for="Input.ConfirmRealMode"/> I explicitly confirm switching this controller from simulated to real-data mode.</label>
<h2>8. Save</h2><label>Reason (optional)<textarea asp-for="Input.ChangeReason" rows="3"></textarea></label><label>Notes (optional)<textarea asp-for="Input.Notes" rows="3"></textarea></label><div class="btn-row"><button id="modbus-test" asp-page-handler="Test" class="warn">Test communication</button><button asp-page-handler="Save">Save controller configuration</button></div></form>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script src="~/js/bacnet-commissioning.js" asp-append-version="true"></script><script>(()=>{const type=document.getElementById('communication-type'),rtu=document.getElementById('rtu-settings'),ip=document.getElementById('ip-settings'),tcp=document.getElementById('tcp-settings'),bacnet=document.getElementById('bacnet-settings'),unit=document.getElementById('modbus-unit');function update(){const isRtu=type.value==='ModbusRtu',isTcp=type.value==='ModbusTcp',isBacnet=type.value==='BacnetIp';rtu.hidden=!isRtu;ip.hidden=!(isTcp||isBacnet);tcp.hidden=!isTcp;bacnet.hidden=!isBacnet;unit.hidden=isBacnet;document.getElementById("assigned-registers").hidden=isBacnet;document.getElementById("bacnet-actions").hidden=!isBacnet;document.getElementById("modbus-test").hidden=isBacnet;}type.addEventListener('change',update);update();})();</script>}
