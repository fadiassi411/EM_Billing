@page "{id:int?}"
@model MallEnergyBilling.Web.Pages.Admin.Controllers.EditModel
@{ViewData["Title"]=Model.Input.Id==0?"Add controller":"Edit controller";}
<section class="hero compact"><div><span class="eyebrow">ADMINISTRATOR ONLY</span><h1>@ViewData["Title"]</h1><p>Configure, confirm and test communication before enabling collection.</p></div><a class="button" asp-page="Index">Back to controllers</a></section>
@if(Model.TestResult is not null){<div class="sim-banner">@Model.TestResult</div>}
<form method="post" class="panel admin-form"><div asp-validation-summary="All" class="validation"></div><input type="hidden" asp-for="Input.Id"/>
<h2>1. Controller identity</h2><div class="form-grid"><label>Name<input asp-for="Input.Name"/></label><label>MDB panel<input asp-for="Input.MdbPanel"/></label><label>Communication type<select asp-for="Input.CommunicationType"><option value="ModbusRtu">Modbus RTU</option></select></label><label class="check"><input asp-for="Input.Enabled"/> Enabled</label></div>
<h2>2–3. Windows serial and Modbus address</h2><div class="form-grid"><label>Windows USB/RS-485 port<input asp-for="Input.ComPort"/></label><label>Baud rate<select asp-for="Input.BaudRate"><option>9600</option><option>19200</option><option>38400</option><option>57600</option><option>115200</option></select></label><label>Parity<select asp-for="Input.Parity"><option>None</option><option>Even</option><option>Odd</option></select></label><label>Data bits<input asp-for="Input.DataBits"/></label><label>Stop bits<input asp-for="Input.StopBits"/></label><label>Slave address<input asp-for="Input.SlaveAddress"/></label></div>
<h2>4. Polling resilience</h2><div class="form-grid"><label>Polling interval (seconds)<input asp-for="Input.PollingIntervalSeconds"/></label><label>Response timeout (ms)<input asp-for="Input.TimeoutMilliseconds"/></label><label>Retry count<input asp-for="Input.RetryCount"/></label></div>
<h2>5. Assigned meter registers</h2>@if(Model.Input.Id==0){<p class="note">Save the controller first, then assign and configure meters.</p>}else if(Model.Meters.Count==0){<p class="note">No meters are assigned to this controller.</p>}else{<table><thead><tr><th>Meter</th><th>Register</th><th>Type / word order</th><th>Scale</th><th></th></tr></thead><tbody>@foreach(var m in Model.Meters){<tr><td>@m.Name<small>@m.SerialNumber</small></td><td>@m.StartingRegister</td><td>@m.DataType · @m.WordOrder</td><td>@m.ScalingFactor</td><td><a class="button" asp-page="Meter" asp-route-id="@m.Id">Edit register</a></td></tr>}</tbody></table>}
<h2>6–7. Test and commissioning confirmation</h2><p class="note">Test Communication opens the Windows serial port and performs a real Modbus RTU Function 03 read of the first assigned meter channel.</p><label class="check"><input asp-for="Input.ConfirmRealMode"/> I explicitly confirm switching this controller from simulated to real-data mode.</label>
<h2>8. Save</h2><label>Reason (optional)<textarea asp-for="Input.ChangeReason" rows="3"></textarea></label><label>Notes (optional)<textarea asp-for="Input.Notes" rows="3"></textarea></label><div class="btn-row"><button asp-page-handler="Test" class="warn">Test communication</button><button asp-page-handler="Save">Save controller configuration</button></div></form>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
