@page
@model MallEnergyBilling.Web.Pages.Admin.Controllers.IndexModel
@{ ViewData["Title"]="Controller communication"; }
<section class="hero compact"><div><span class="eyebrow">ADMINISTRATOR ONLY</span><h1>Controller communication</h1><p>Add controllers and configure RTU communication. These controls are hidden from all other roles.</p></div><a class="button" asp-page="Edit">+ Add controller</a></section>
@if(TempData["Error"] is string error){<div class="alert-error">@error</div>}@if(TempData["Success"] is string success){<div class="alert-success">@success</div>}
<section class="panel"><table><thead><tr><th>Controller</th><th>Communication</th><th>Serial settings</th><th>Slave</th><th>Condition</th><th></th></tr></thead><tbody>@foreach(var x in Model.Controllers){<tr><td><b>@x.Name</b><small>@x.MdbPanel</small></td><td>@x.CommunicationType</td><td>@x.ComPort · @x.BaudRate · @x.Parity · @x.DataBits/@x.StopBits</td><td>@x.SlaveAddress</td><td><span class="status">@x.Condition</span></td><td><div class="btn-row"><a class="button" asp-page="Edit" asp-route-id="@x.Id">Edit / test</a><a class="button" asp-page="Channels" asp-route-id="@x.Id">36 channels</a><form method="post" asp-page-handler="Delete" asp-route-id="@x.Id" onsubmit="return confirm('Are you sure you want to delete controller');"><button class="danger-btn">Delete</button></form></div></td></tr>}</tbody></table></section>
