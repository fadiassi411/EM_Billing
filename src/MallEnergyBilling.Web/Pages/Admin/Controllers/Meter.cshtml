@page "{id:int}"
@model MallEnergyBilling.Web.Pages.Admin.Controllers.MeterModel
@{ViewData["Title"]="Meter channel configuration";}
<section class="hero compact"><div><span class="eyebrow">ADMINISTRATOR ONLY</span><h1>@Model.Input.Name</h1><p>Commission the physical meter and its controller or gateway register.</p></div></section>
@if(Model.IsMBus && (Model.MBusAnswer is not null || Model.MBusReadError is not null)){
<section class="panel mbus-answer" id="mbus-answer">
 <h2>M-Bus meter answer</h2>
 @if(Model.MBusAnswer is { } t){
  <p class="note">ID <b>@t.SecondaryAddress</b> · manufacturer <b>@t.Manufacturer</b> · @t.Medium · version @t.Version · status 0x@(t.Status.ToString("X2"))@(t.MoreRecordsFollow?" · more records exist in a second telegram (not read)":"")</p>
  <div class="table-responsive"><table><thead><tr><th>Record</th><th>Measurement</th><th>Value</th><th>Unit</th><th>Storage</th><th>Tariff</th><th>Type</th><th></th></tr></thead><tbody>
  @foreach(var r in t.Records){var billed=r.Index==Model.MBusBilledRecord;<tr class="@(billed?"is-billed":"")"><td><b>@r.Index</b></td><td>@r.Description</td><td>@(r.Value?.ToString("0.######")??"—")</td><td>@r.Unit</td><td>@(r.StorageNumber==0?"Current":$"Stored {r.StorageNumber}")</td><td>@(r.Tariff==0?"—":r.Tariff.ToString())@(r.SubUnit!=0?$" · sub-unit {r.SubUnit}":"")</td><td>@r.Function</td><td>@if(billed){<span class="status">Billed</span>}</td></tr>}
  </tbody></table></div>
  <p class="note">The <b>Billed</b> row is the value Watchdog stores and bills, multiplied by the scaling factor. To bill another record, enter its number in <i>Billing record</i> below and save.</p>
 }
 @if(Model.MBusReadError is string error){<div class="alert-error">@error</div>}
</section>}
<form method="post" class="panel admin-form"><div asp-validation-summary="All" class="validation"></div><input type="hidden" asp-for="Input.Id"/><div class="form-grid">
<label>Meter name<input asp-for="Input.Name"/></label><label>Physical meter serial number<input asp-for="Input.SerialNumber"/></label><label>Controller / gateway<input value="@Model.ControllerName" readonly/></label>
<label>Utility type<select asp-for="Input.UtilityType" asp-items="Html.GetEnumSelectList<MallEnergyBilling.Web.Models.UtilityType>()"></select><small>@(Model.IsMBus?"Electricity and heat meters bill the energy total (kWh); Water bills the volume total (m³).":"Select Water for an M-Bus meter exposed by a Modbus gateway.")</small></label>
<label>Electricity source<select asp-for="Input.PowerSource" asp-items="Html.GetEnumSelectList<MallEnergyBilling.Web.Models.PowerSource>()"></select><small>Used only when Utility type is Electricity.</small></label>
@if(Model.ControllerCommunicationType=="BacnetIp"){<a class="button" asp-page="Points" asp-route-id="@Model.Input.Id">BACnet Points / Browse BACnet Objects / Test Read</a><input type="hidden" asp-for="Input.BacnetObjectType"/><input type="hidden" asp-for="Input.BacnetObjectInstance"/><input type="hidden" asp-for="Input.Offset"/>}
else if(Model.IsMBus){<label>M-Bus primary address<input asp-for="Input.StartingRegister" min="0" max="250"/><small>0–250, as set in the meter. Ignored when an ID is entered.</small></label><label>M-Bus secondary address (ID, optional)<input asp-for="Input.MBusSecondaryAddress" placeholder="8 digits from the meter label" inputmode="numeric"/><small>Use the ID when several meters share the same primary address (for example all at 0).</small></label><label>Billing record<input asp-for="Input.MBusRecord" min="0" max="250"/><small>0 = automatic (current total). Use <i>Read meter</i> to see the record numbers.</small></label><input type="hidden" asp-for="Input.DataType"/><input type="hidden" asp-for="Input.WordOrder"/>}
else{<label>First register address<input asp-for="Input.StartingRegister"/></label><label>Data type<select asp-for="Input.DataType" asp-items="Html.GetEnumSelectList<MallEnergyBilling.Web.Models.RegisterDataType>()"></select></label><label>Word order<select asp-for="Input.WordOrder" asp-items="Html.GetEnumSelectList<MallEnergyBilling.Web.Models.WordOrder>()"></select></label>}
<label>Shop assignment<select asp-for="Input.ShopId">@foreach(var s in Model.Shops){<option value="@s.Id">@s.ShopNumber — @s.Name</option>}</select></label><label class="check"><input asp-for="Input.Active"/> Commissioned and active</label>
@if(Model.IsMBus){<label>Scaling factor<input asp-for="Input.ScalingFactor"/><small>Usually 1: M-Bus values already arrive in kWh or m³. Change only for a known meter fault.</small></label><input type="hidden" asp-for="Input.PulseConstant"/><input type="hidden" asp-for="Input.CtPrimary"/><input type="hidden" asp-for="Input.CtSecondary"/><input type="hidden" asp-for="Input.CtAppliedByPlc"/>}
else if(Model.ControllerCommunicationType!="BacnetIp"){<label>Scaling factor<input asp-for="Input.ScalingFactor"/><small>Use only the conversion specified by the meter/gateway object/register map.</small></label><label>Pulse constant (electricity only)<input asp-for="Input.PulseConstant"/></label><label>CT primary (electricity only)<input asp-for="Input.CtPrimary"/></label><label>CT secondary (electricity only)<input asp-for="Input.CtSecondary"/></label><label class="check"><input asp-for="Input.CtAppliedByPlc"/> CT ratio already applied (electricity only)</label>}
else{<input type="hidden" asp-for="Input.ScalingFactor"/><input type="hidden" asp-for="Input.PulseConstant"/><input type="hidden" asp-for="Input.CtPrimary"/><input type="hidden" asp-for="Input.CtSecondary"/>}</div>
@if(Model.ControllerCommunicationType!="BacnetIp"){
<fieldset class="offset-match"><legend>Offset — match the meter display</legend>
 <p class="note">Watchdog shows <b>device value × scaling factor + offset</b>. Use the offset when the PLC or gateway counts from 0 but the meter display already shows a total. Changing the offset starts a new counter on the next reading, so the difference is never billed.</p>
 <div class="form-grid">
  <label>Offset (@Model.Unit)<input asp-for="Input.Offset" step="any"/><small>Can be negative. 0 = no offset.</small></label>
  <label>Meter display now (@Model.Unit)<input id="display-now" type="number" step="any" placeholder="Read it from the meter"/><small>@(Model.LastReadingAt is null?"Available after the first reading.":$"Watchdog read {Model.LastReading:0.###} {Model.Unit} at {Model.LastReadingAt.Value.ToLocalTime():dd MMM HH:mm}.")</small></label>
  <div class="offset-calc"><button type="button" class="secondary" id="calc-offset" data-last="@Model.LastReading.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-saved="@Model.SavedOffset.ToString(System.Globalization.CultureInfo.InvariantCulture)" @(Model.LastReadingAt is null?"disabled":"")>Calculate offset</button><small id="offset-result" role="status"></small></div>
 </div>
</fieldset>}
<label>Notes (optional)<textarea asp-for="Input.Notes" rows="2"></textarea></label><label>Reason (optional)<textarea asp-for="Input.Reason" rows="2"></textarea></label>
<div class="btn-row">@if(Model.IsMBus){<button type="submit" class="secondary" asp-page-handler="ReadMBus" formnovalidate>Read meter</button>}<button>Save meter channel</button></div></form>
@section Scripts{<script>(()=>{const b=document.getElementById('calc-offset');if(!b)return;b.addEventListener('click',()=>{const display=parseFloat(document.getElementById('display-now').value);const out=document.getElementById('offset-result');if(!isFinite(display)){out.textContent='Enter the number shown on the meter first.';return;}const device=parseFloat(b.dataset.last)-parseFloat(b.dataset.saved);const offset=Math.round((display-device)*1000)/1000;document.getElementById('Input_Offset').value=offset;out.textContent='Offset set to '+offset+'. Save the meter to apply it.';});})();</script>}
