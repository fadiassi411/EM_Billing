@page "{id:int}"
@model MallEnergyBilling.Web.Pages.Admin.Controllers.MeterModel
@{ViewData["Title"]="Meter channel configuration";}
<section class="hero compact"><div><span class="eyebrow">ADMINISTRATOR ONLY</span><h1>@Model.Input.Name</h1><p>Commission the physical meter and its controller or gateway register.</p></div></section>
<form method="post" class="panel admin-form"><div asp-validation-summary="All" class="validation"></div><input type="hidden" asp-for="Input.Id"/><div class="form-grid">
<label>Meter name<input asp-for="Input.Name"/></label><label>Physical meter serial number<input asp-for="Input.SerialNumber"/></label><label>Controller / gateway<input value="@Model.ControllerName" readonly/></label>
<label>Utility type<select asp-for="Input.UtilityType" asp-items="Html.GetEnumSelectList<MallEnergyBilling.Web.Models.UtilityType>()"></select><small>Select Water for an M-Bus meter exposed by a Modbus gateway.</small></label>
<label>Electricity source<select asp-for="Input.PowerSource" asp-items="Html.GetEnumSelectList<MallEnergyBilling.Web.Models.PowerSource>()"></select><small>Used only when Utility type is Electricity.</small></label>
<label>First register address<input asp-for="Input.StartingRegister"/></label><label>Shop assignment<select asp-for="Input.ShopId">@foreach(var s in Model.Shops){<option value="@s.Id">@s.ShopNumber — @s.Name</option>}</select></label><label class="check"><input asp-for="Input.Active"/> Commissioned and active</label><label>Data type<select asp-for="Input.DataType" asp-items="Html.GetEnumSelectList<MallEnergyBilling.Web.Models.RegisterDataType>()"></select></label><label>Word order<select asp-for="Input.WordOrder" asp-items="Html.GetEnumSelectList<MallEnergyBilling.Web.Models.WordOrder>()"></select></label><label>Scaling factor<input asp-for="Input.ScalingFactor"/><small>Use only the conversion specified by the meter/gateway register map.</small></label><label>Pulse constant (electricity only)<input asp-for="Input.PulseConstant"/></label><label>CT primary (electricity only)<input asp-for="Input.CtPrimary"/></label><label>CT secondary (electricity only)<input asp-for="Input.CtSecondary"/></label><label class="check"><input asp-for="Input.CtAppliedByPlc"/> CT ratio already applied (electricity only)</label></div><label>Notes (optional)<textarea asp-for="Input.Notes" rows="2"></textarea></label><label>Reason (optional)<textarea asp-for="Input.Reason" rows="2"></textarea></label><button>Save meter channel</button></form>
