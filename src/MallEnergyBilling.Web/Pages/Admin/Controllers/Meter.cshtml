@page "{id:int}"
@model MallEnergyBilling.Web.Pages.Admin.Controllers.MeterModel
@{ViewData["Title"]="Meter channel configuration";}
<section class="hero compact"><div><span class="eyebrow">ADMINISTRATOR ONLY</span><h1>@Model.Input.Name</h1><p>Commission the physical meter and its PLC register.</p></div></section><form method="post" class="panel admin-form"><div asp-validation-summary="All" class="validation"></div><input type="hidden" asp-for="Input.Id"/><div class="form-grid"><label>Meter name<input asp-for="Input.Name"/></label><label>Physical meter serial number<input asp-for="Input.SerialNumber"/></label><label>Controller<input value="@Model.ControllerName" readonly/></label><label>Power source<select asp-for="Input.PowerSource" asp-items="Html.GetEnumSelectList<MallEnergyBilling.Web.Models.PowerSource>()"></select><small>The meter automatically appears on the selected UMEME or Generator page.</small></label><label>First register address<input asp-for="Input.StartingRegister"/></label><label>Shop assignment<select asp-for="Input.ShopId">@foreach(var s in Model.Shops){<option value="@s.Id">@s.ShopNumber — @s.Name</option>}</select></label><label class="check"><input asp-for="Input.Active"/> Commissioned and active</label><label>Data type<select asp-for="Input.DataType" asp-items="Html.GetEnumSelectList<MallEnergyBilling.Web.Models.RegisterDataType>()"></select></label><label>Word order<select asp-for="Input.WordOrder" asp-items="Html.GetEnumSelectList<MallEnergyBilling.Web.Models.WordOrder>()"></select></label><label>Scaling factor<input asp-for="Input.ScalingFactor"/></label><label>Pulse constant (imp/kWh)<input asp-for="Input.PulseConstant"/></label><label>CT primary<input asp-for="Input.CtPrimary"/></label><label>CT secondary<input asp-for="Input.CtSecondary"/></label><label class="check"><input asp-for="Input.CtAppliedByPlc"/> CT ratio already applied by PLC</label></div><label>Notes (optional)<textarea asp-for="Input.Notes" rows="2"></textarea></label><label>Reason (optional)<textarea asp-for="Input.Reason" rows="2"></textarea></label><button>Save meter channel</button></form>
