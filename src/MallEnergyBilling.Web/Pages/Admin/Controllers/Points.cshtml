@page "{id:int}"
@model MallEnergyBilling.Web.Pages.Admin.Controllers.PointsModel
@using MallEnergyBilling.Web.Models
@using MallEnergyBilling.Web.Services
@{ ViewData["Title"]="BACnet points"; var c=Model.Meter.Controller!; }
<section class="hero compact"><div><span class="eyebrow">BACNET COMMISSIONING</span><h1>@Model.Meter.Name — BACnet points</h1><p>Map numerical objects to meter measurements. Billing uses only the explicitly confirmed cumulative import-energy point.</p></div><a class="button" asp-page="Meter" asp-route-id="@Model.Meter.Id">Meter settings</a></section>
<section class="panel"><h2>Device diagnostics</h2><div class="form-grid"><p>Local interface <b>@c.BacnetLocalIp</b></p><p>Target <b>@c.IpAddress:@c.BacnetUdpPort</b></p><p>Device Instance <b>@(c.BacnetDeviceInstance?.ToString()??"Unknown")</b></p><p>Status <b>@Model.Meter.DisplayStatus</b></p><p>Last polling attempt @c.BacnetLastAttempt?.ToLocalTime()</p><p>Last response @c.LastSuccess?.ToLocalTime()</p><p>Consecutive failures @c.BacnetConsecutiveFailures</p><p>Last error @c.BacnetLastError</p></div><a asp-page="Edit" asp-route-id="@c.Id">Edit network / Test BACnet Connection / Discover BACnet Devices</a></section>
@if(Model.Message.Length>0){<div class="sim-banner" role="status">@Model.Message</div>}
@if(Model.TestResult is {} r){<section class="panel"><h2>Real point test</h2><p>@Model.Input.ObjectType:@Model.Input.ObjectInstance · property @Model.Input.PropertyId</p><p>Raw value: @r.Raw · Final scaled value: @r.Value @Model.Input.Unit · Quality: @r.Quality · Timestamp: @r.Timestamp.ToLocalTime()</p><p>@r.Error</p></section>}
<section class="panel"><h2>Configured points</h2><a class="button" asp-page="Points" asp-route-id="@Model.Meter.Id">Add Point</a><div class="table-responsive"><table><thead><tr><th>Point / measurement</th><th>Object / property</th><th>Last value</th><th>Quality / last success</th><th></th></tr></thead><tbody>
@foreach(var p in Model.Meter.BacnetPoints){<tr><td>@p.Name<small>@p.Measurement @(p.BillingConfirmed?"— billing confirmed":"")</small></td><td>@p.ObjectType:@p.ObjectInstance / @p.PropertyId</td><td>@p.LastValue @p.Unit</td><td>@p.EffectiveQuality(c.PollingIntervalSeconds,DateTimeOffset.UtcNow)<small>@p.LastSuccess?.ToLocalTime() · @p.LastError</small></td><td><a class="button" asp-page="Points" asp-route-id="@Model.Meter.Id" asp-route-pointId="@p.Id">Edit / Test Read</a><form method="post" asp-page-handler="Delete" onsubmit="return confirm('Delete this point mapping? Billing history is retained.');"><input type="hidden" name="pointId" value="@p.Id"/><button>Delete</button></form></td></tr>}
</tbody></table></div></section>
<form method="post" class="panel admin-form" id="point-form"><h2>@(Model.Input.Id==0?"Add Point":"Edit Point")</h2><div asp-validation-summary="All" class="validation"></div><input type="hidden" asp-for="Input.Id"/><div class="form-grid">
<label>Point Name<input asp-for="Input.Name"/></label><label>Watchdog Measurement<select asp-for="Input.Measurement" asp-items="Html.GetEnumSelectList<MeasurementType>()"></select></label>
<label>BACnet Object Type<select asp-for="Input.ObjectType">@foreach(var type in BacnetIpService.ObjectTypes){<option>@type</option>}</select></label><label>Object Instance<input asp-for="Input.ObjectInstance"/></label><label>Property identifier<input asp-for="Input.PropertyId"/><small>85 = Present_Value (default). Object + instance + property identify the point.</small></label><label>Final Engineering Unit<input asp-for="Input.Unit"/><small>Use kWh for billing. Convert Wh to kWh explicitly with scale 0.001 if needed.</small></label><label>Scaling Factor<input asp-for="Input.Scale"/></label><label>Offset<input asp-for="Input.Offset"/></label><label class="check"><input asp-for="Input.Enabled"/> Enabled</label></div>
<label class="check"><input asp-for="Input.BillingConfirmed"/> I confirm this is the physical meter's cumulative Total Import Energy in kWh, to be used for billing.</label><div class="btn-row"><button asp-page-handler="Save">Save Point</button><button asp-page-handler="Test">Test Read</button></div></form>
<section class="panel"><h2>Browse device objects</h2><form method="post" asp-page-handler="Browse"><button>Browse BACnet Objects</button></form><p>Browsing is optional. Manual object entry works when Object_List is restricted. Mapping suggestions are never saved automatically.</p><div class="table-responsive"><table><thead><tr><th>Object</th><th>Name / description</th><th>Present Value</th><th>Unit</th><th>Reliability / Status_Flags</th><th></th></tr></thead><tbody>
@foreach(var o in Model.Objects){<tr><td>@o.Type:@o.Instance</td><td>@o.Name<small>@o.Description</small></td><td>@o.Value</td><td>@o.Unit</td><td>@o.Reliability / @o.Status</td><td>@if(BacnetIpService.ObjectTypes.Contains(o.Type)){<button type="button" class="select-object" data-type="@o.Type" data-instance="@o.Instance" data-name="@o.Name" data-unit="@o.Unit">Select / Map</button>}</td></tr>}
</tbody></table></div></section>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script>document.querySelectorAll('.select-object').forEach(b=>b.addEventListener('click',()=>{const f=document.getElementById('point-form');Object.entries({Id:0,Name:b.dataset.name||'Meter point',ObjectType:b.dataset.type,ObjectInstance:b.dataset.instance,PropertyId:85,Unit:b.dataset.unit,Measurement:0,Scale:1,Offset:0}).forEach(([k,v])=>f.elements['Input.'+k].value=v);f.elements['Input.BillingConfirmed'][0].checked=false;f.scrollIntoView({behavior:'smooth'});}));</script>}
