@page
@model MallEnergyBilling.Web.Pages.Admin.Users.IndexModel
@{ ViewData["Title"] = "Users & Access"; }

<section class="hero compact">
    <div>
        <span class="eyebrow">ADMINISTRATOR ONLY</span>
        <h1>Users &amp; Access</h1>
        <p>Create user accounts and assign one access level to each user.</p>
    </div>
</section>

@if (TempData["Success"] is string success) { <div class="alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert-error">@error</div> }

<section class="panel admin-form">
    <h2>Add new user</h2>
    <p class="note">The username and password are used to sign in. Email is stored only as contact information.</p>
    <form method="post" asp-page-handler="Create">
        <div asp-validation-summary="All" class="validation"></div>
        <div class="form-grid">
            <label>Username<input asp-for="NewUser.Username" autocomplete="off" placeholder="username" /></label>
            <label>Email <small>Information only (optional)</small><input asp-for="NewUser.Email" autocomplete="off" placeholder="user@example.com" /></label>
            <label>Access level<select asp-for="NewUser.AccessLevel">@foreach (var accessLevel in MallEnergyBilling.Web.Pages.Admin.Users.IndexModel.AccessLevels) { <option value="@accessLevel">@accessLevel</option> }</select></label>
            <label>Temporary password<input asp-for="NewUser.Password" autocomplete="new-password" placeholder="Minimum 10 characters" /></label>
            <label>Confirm password<input asp-for="NewUser.ConfirmPassword" autocomplete="new-password" /></label>
        </div>
        <button type="submit">Create user</button>
    </form>
</section>

<section class="panel">
    <h2>User access levels</h2>
    <div asp-validation-summary="All" class="validation"></div>
    <div class="table-responsive">
        <table>
            <thead><tr><th>Username</th><th>Email information</th><th>Current access</th><th>New access level</th><th></th></tr></thead>
            <tbody>
            @if (Model.Users.Count == 0)
            {
                <tr><td colspan="5">No registered users were found.</td></tr>
            }
            @foreach (var account in Model.Users)
            {
                <tr>
                    <td><b>@account.Username</b>@if (User.Identity?.Name == account.Username) { <small>Current account</small> }</td>
                    <td>@account.Email</td>
                    <td><span class="status">@account.AccessLevel</span></td>
                    <td>
                        <form method="post" class="btn-row">
                            <input type="hidden" name="UserId" value="@account.Id" />
                            <select name="AccessLevel" aria-label="Access level for @account.Username">
                                @foreach (var accessLevel in MallEnergyBilling.Web.Pages.Admin.Users.IndexModel.AccessLevels)
                                {
                                    <option value="@accessLevel" selected="@(account.AccessLevel == accessLevel)">@accessLevel</option>
                                }
                            </select>
                            <button type="submit">Save access</button>
                        </form>
                    </td>
                    <td>
                        <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Are you sure you want to delete this user?');">
                            <input type="hidden" name="userId" value="@account.Id" />
                            <button type="submit" class="danger-btn">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

<section class="panel">
    <h2>Access level permissions</h2>
    <div class="table-responsive">
        <table>
            <thead><tr><th>Access level</th><th>Permission</th></tr></thead>
            <tbody>
                <tr><td><b>Administrator</b></td><td>Full system configuration, controllers, meters, shops, billing, users, audit, backup and restore.</td></tr>
                <tr><td><b>Billing Manager</b></td><td>Create, finalize and manage billing periods and invoices.</td></tr>
                <tr><td><b>Operator</b></td><td>Operational pages and meter monitoring without administrator configuration.</td></tr>
                <tr><td><b>Viewer</b></td><td>View permitted dashboards and operational information.</td></tr>
            </tbody>
        </table>
    </div>
</section>
