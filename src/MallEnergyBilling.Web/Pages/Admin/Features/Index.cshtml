@page
@model MallEnergyBilling.Web.Pages.Admin.Features.IndexModel
@{ViewData["Title"]="System features";}
<section class="hero compact"><div><span class="eyebrow">ADMINISTRATOR ONLY</span><h1>System features</h1><p>Enable only the utility services installed at this property.</p></div></section>
@if(TempData["Success"] is string success){<div class="alert-success">@success</div>}
<section class="panel admin-form water-feature-panel"><h2>Water metering and billing</h2><form method="post"><label class="check"><input asp-for="WaterBillingEnabled"/> Enable Water pages, water-meter configuration and water billing</label><p class="note">Water meters are read from the accumulated-volume registers exposed by an M-Bus-to-Modbus TCP gateway. Watchdog Energy Management records and bills the gateway value; it does not calculate water volume.</p><button>Save feature settings</button></form></section>
